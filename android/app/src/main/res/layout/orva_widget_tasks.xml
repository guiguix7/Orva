<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orva_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/widget_locked" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="TAREFAS DE HOJE"
            android:textColor="@color/orva_widget_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_tasks_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="1 de 4 concluídas"
            android:textColor="@color/orva_widget_text"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Alongar por 10 minutos"
                android:textColor="@color/orva_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_task_source_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rotina da manhã"
                android:textColor="@color/orva_widget_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Revisar a agenda do dia"
                android:textColor="@color/orva_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_task_source_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rotina da manhã"
                android:textColor="@color/orva_widget_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Ler 20 páginas"
                android:textColor="@color/orva_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_task_source_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Estudo"
                android:textColor="@color/orva_widget_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_title_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Beber água"
                android:textColor="@color/orva_widget_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_task_source_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Saúde"
                android:textColor="@color/orva_widget_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tasks_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nada pendente agora."
            android:textColor="@color/orva_widget_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/widget_footer" />
</LinearLayout>
