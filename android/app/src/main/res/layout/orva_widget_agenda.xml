<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orva_widget_background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/widget_locked" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="AGENDA · HOJE"
            android:textColor="@color/orva_widget_dark_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_agenda_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="2 próximos blocos"
            android:textColor="@color/orva_widget_dark_text"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/widget_agenda_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_agenda_time_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="19:30–21:30"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_agenda_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Faculdade"
                android:textColor="@color/orva_widget_dark_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_agenda_subtitle_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Estudo · agora"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_agenda_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_agenda_time_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="22:00–23:00"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_agenda_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Leitura"
                android:textColor="@color/orva_widget_dark_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_agenda_subtitle_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Leitura · planejado"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_agenda_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_agenda_time_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="07:00–08:00"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_agenda_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Revisão"
                android:textColor="@color/orva_widget_dark_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/widget_agenda_subtitle_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Estudo · planejado"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_agenda_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nada mais planejado para hoje."
            android:textColor="@color/orva_widget_dark_secondary"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/widget_footer" />
</LinearLayout>
