<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/orva_widget_background_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <include layout="@layout/widget_locked" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_today_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="SEGUNDA, 16 DE NOVEMBRO"
            android:textColor="@color/orva_widget_dark_secondary"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_today_phase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/orva_widget_badge_dark"
            android:letterSpacing="0.06"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="ACONTECENDO AGORA"
            android:textColor="@color/orva_widget_dark_secondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/widget_today_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Faculdade"
            android:textColor="@color/orva_widget_dark_text"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="termina 21:30"
                android:textColor="@color/orva_widget_dark_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_today_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Estudo"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_checklist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="1 de 4 tarefas"
                android:textColor="@color/orva_widget_dark_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_today_planned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Planejado hoje · 4h"
                android:textColor="@color/orva_widget_dark_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_footer" />
</LinearLayout>
